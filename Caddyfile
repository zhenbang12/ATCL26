atcl.site, www.atcl.site {
    # Allow file uploads up to 50MB for receipts, photos, and media
    request_body {
        max_size 50MB
    }

    # Block sensitive paths, dotfiles, archives, and database scripts
    @blocked {
        path /.git* /.env* /*.sql /*.zip /*.sh /*.bat /database/*
    }
    respond @blocked 403

    # Proxy all legitimate traffic to the Apache PHP container
    reverse_proxy web:80
}
